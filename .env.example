# API key Claude (bắt buộc). Không commit key thật vào repo.
ANTHROPIC_API_KEY=

# Mã truy cập trang (nên đặt, để người ngoài không dùng được API key của công ty)
APP_PASSWORD=

# Đăng nhập Google (đặt đủ 3 biến đầu thì trang dùng Google thay cho mã truy cập)
# Authorized redirect URI cần khai báo trong Google Cloud Console: <địa chỉ trang>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# Giới hạn người được vào, cách nhau bằng dấu phẩy. Bỏ trống cả hai thì mọi tài khoản Google đều vào được.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Tùy chọn
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
